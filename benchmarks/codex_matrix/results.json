  "tasks": {
    "line-count": {
      "target": "llm/read_hint.py",
      "prompt": "Fix line_count so a nonempty final line without a newline is counted. Empty files must count as zero; trailing newlines must not create an extra line. Keep missing-file, directory and size-limit behavior."
    },
    "quoted-shell": {
      "target": "llm/read_hint.py",
      "prompt": "Fix bash_targets to preserve shell control characters inside quoted filenames, including ;, &&, | and >. Still recognize unquoted command separators, and skip an entire pipeline or redirection segment. Preserve filename order and silently ignore unmatched quotes. No shell execution or new dependencies."
    },
    "codex-hook": {
      "target": "llm/read_hint.py",
      "prompt": "Extend targets to accept Codex exec_command hooks, whose tool_input uses cmd. Preserve Claude Bash command and Read file_path handling, including ranged-read suppression. Empty inputs and unsupported tool names must return no targets. Pipelines must still produce no targets."
    },
    "version-boundary": {
      "target": "llm/context7_version_guard.py",
      "prompt": "Fix mentions: accept either the exact pinned dotted numeric version or its major.minor as a complete version token, optionally prefixed with v. For a pin of 2.1.0 accept 2.1 and v2.1.0, but reject 12.1.0, 2.10.0, 2.1.01 and 2.1.9. Punctuation may surround the version. Keep the public API."
    },
    "npm-pins": {
      "target": "llm/context7_version_guard.py",
      "prompt": "Extend pinned_versions to read exact dotted numeric versions from dependencies and devDependencies in the root package.json. Match existing normalized package names. Ignore ranges (^, ~, wildcard, >=) and non-exact values. Report package.json as the source and preserve existing pin-source precedence. The existing check() caller must deny unversioned queries and accept matching major.minor queries for these new pins. Preserve current Python and installed-node_modules pin support."
    },
    "tail-boundary": {
      "target": "llm/idle_compact.py",
      "prompt": "Fix records(path, tail): when the byte-tail starts exactly at a JSONL record boundary, retain that first complete record. When it starts inside a record, discard only the partial record. Preserve unbounded reads, malformed-record filtering and missing-file handling. The shared fix must also work through codex_records without changing its API."
    }
  },
