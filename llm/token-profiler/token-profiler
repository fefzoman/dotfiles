            "ended_at": report.inner_ended_at,
            "elapsed_seconds": duration_seconds(report.inner_started_at, report.inner_ended_at),
            "usage": {
                **dataclasses.asdict(report.inner_usage),
                "fresh_input_tokens": report.inner_usage.fresh_input_tokens,
                "cache_hit_ratio": report.inner_usage.cache_hit,
