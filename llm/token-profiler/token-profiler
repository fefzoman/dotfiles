CATEGORY_ORDER = [
    "Repository/file reads",
    "Shell command output",
    "Tests",
    "MCP/tool results",
    "File changes",
    "Conversation/history",
    "AGENTS.md/instructions",
    "Compacted history",
    "Other visible context",
    "Other/platform context",
]


def ordered_items(d: dict[str, float | int]) -> list[tuple[str, float]]:
    order = {name: i for i, name in enumerate(CATEGORY_ORDER)}
    return sorted(
        ((k, float(v)) for k, v in d.items() if v),
        key=lambda kv: (-kv[1], order.get(kv[0], 999), kv[0]),
    )


def payload_difference(
    total: dict[str, int],
    remaining: dict[str, int],
) -> dict[str, int]:
    return {
        key: value - remaining.get(key, 0)
        for key, value in total.items()
        if value > remaining.get(key, 0)
    }


def tool_statistics(report: SessionReport) -> list[dict[str, Any]]:
    total_payload = sum(report.tool_payloads.values())
    sizes_by_tool: dict[str, list[int]] = collections.defaultdict(list)
    for result in report.tool_results:
        sizes_by_tool[result.tool].append(result.tokens)
    rows = []
    for name in report.tool_calls.keys() | report.tool_payloads.keys():
        sizes = sizes_by_tool[name]
        tokens = report.tool_payloads.get(name, 0)
        rows.append(
            {
                "name": name,
                "calls": report.tool_calls.get(name, 0),
                "calls_are_lower_bound": name in report.programmatic_tool_calls,
                "result_tokens": tokens,
                "average_result_tokens": round(tokens / len(sizes)) if sizes else 0,
                "max_result_tokens": max(sizes, default=0),
                "payload_ratio": tokens / total_payload if total_payload else 0.0,
            }
        )
    return sorted(rows, key=lambda row: row["result_tokens"], reverse=True)


def normalized_tool_arguments(result: ToolResult) -> str:
    arguments = " ".join(result.arguments.split())
    if result.tool == "tool_inventory":
        query = re.search(r"/((?:\\.|[^/])*)/([a-z]*)\.test", arguments)
        if query:
            return f"/{query.group(1)}/{query.group(2)}"
    if result.tool == "exec_command":
        return extract_command(result.arguments) or arguments
    marker = f"tools.{result.tool}("
    if marker in arguments:
        return arguments.split(marker, 1)[1].split(");", 1)[0]
    return arguments


def tool_result_outliers(
    report: SessionReport, threshold: int = 2_000
) -> list[dict[str, Any]]:
    totals = collections.Counter(
        (result.tool, normalized_tool_arguments(result))
        for result in report.tool_results
    )
    seen: collections.Counter[tuple[str, str]] = collections.Counter()
    rows = []
    for result in report.tool_results:
        key = (result.tool, normalized_tool_arguments(result))
        seen[key] += 1
        if result.tokens > threshold:
            rows.append(
                {
                    **dataclasses.asdict(result),
                    "occurrence": seen[key],
                    "repeated": totals[key] > 1,
                }
            )
    return sorted(rows, key=lambda row: row["tokens"], reverse=True)


def model_call_windows(report: SessionReport) -> list[dict[str, Any]]:
    windows: list[dict[str, Any]] = []
    for index, call in enumerate(report.calls, 1):
        fresh = max(0, call.usage.input_tokens - call.usage.cached_input_tokens)
        if not windows or (
            call.gap_seconds is not None
            and call.gap_seconds > INNER_SESSION_GAP.total_seconds()
        ):
            windows.append(
                {
                    "start_index": index,
                    "started_at": call.timestamp,
                    "calls": 0,
                    "fresh_input_tokens": 0,
                    "first_call_input_tokens": call.usage.input_tokens,
                    "first_call_fresh_tokens": fresh,
                    "later_fresh_tokens": 0,
                }
            )
        window = windows[-1]
        window["calls"] += 1
        window["fresh_input_tokens"] += fresh
        if window["calls"] > 1:
            window["later_fresh_tokens"] += fresh
    for window in windows:
        later_calls = window["calls"] - 1
        window["later_call_average_fresh_tokens"] = round(
            window["later_fresh_tokens"] / later_calls
        ) if later_calls else 0
        window["first_call_share"] = round(
            window["first_call_fresh_tokens"] / window["fresh_input_tokens"], 4
        ) if window["fresh_input_tokens"] else 0.0
    return windows


def render_bar(value: float, max_value: float, width: int = 16) -> str:
    if max_value <= 0:
        return " " * width
    n = max(0, min(width, int(round(width * value / max_value))))
    return "█" * n + "░" * (width - n)


def read_rtk_savings(project: str) -> dict[str, Any] | None:
    rtk = shutil.which("rtk")
    if not rtk:
        return None

    project_path = Path(project).expanduser() if project else None
    project_scoped = bool(project_path and project_path.is_dir())
    command = [rtk, "gain", "--format", "json"]
    if project_scoped:
        command.insert(2, "--project")

    env = os.environ.copy()
    env["RTK_TELEMETRY_DISABLED"] = "1"
    try:
        result = subprocess.run(
            command,
            cwd=str(project_path) if project_scoped else None,
            env=env,
            capture_output=True,
            check=True,
            text=True,
            timeout=5,
        )
        payload = json.loads(result.stdout)
        if not isinstance(payload, dict) or not isinstance(payload.get("summary"), dict):
            return None
        summary = payload["summary"]
        return {
            "scope": "project" if project_scoped else "all",
            "commands": int(summary.get("total_commands") or 0),
            "raw_output_tokens_estimate": int(summary.get("total_input") or 0),
            "filtered_output_tokens_estimate": int(summary.get("total_output") or 0),
            "saved_tokens_estimate": int(summary.get("total_saved") or 0),
            "average_savings_percent": float(summary.get("avg_savings_pct") or 0),
        }
    except (OSError, subprocess.SubprocessError, ValueError, TypeError):
        return None


def read_headroom_savings() -> dict[str, Any] | None:
    headroom = shutil.which("headroom")
    if not headroom:
        return None

    env = os.environ.copy()
    env["HEADROOM_BEACON"] = "off"
    try:
        result = subprocess.run(
            [headroom, "savings", "--json"],
            env=env,
            capture_output=True,
            check=True,
            text=True,
            timeout=5,
        )
        payload = json.loads(result.stdout)
        lifetime = payload.get("lifetime")
        windows = payload.get("windows")
        if not isinstance(lifetime, dict) or not isinstance(windows, dict):
            return None
        return {
            "scope": "global ledger",
            "top_model": str(payload.get("top_model") or "unknown"),
            "lifetime": lifetime,
            "today": windows.get("today") or {},
            "last_7_days": windows.get("last_7_days") or {},
            "last_30_days": windows.get("last_30_days") or {},
        }
    except (OSError, subprocess.SubprocessError, ValueError, TypeError):
        return None


def read_ponytail_status(agent: str, profile_home: Path) -> dict[str, Any]:
    policy_path = profile_home / ("AGENTS.md" if agent == "codex" else "CLAUDE.md")
    policy_active = False
    try:
        policy_active = "Ponytail:" in policy_path.read_text(encoding="utf-8")
    except OSError:
        pass

    plugin_enabled: bool | None = None
    try:
        if agent == "codex":
            config = (profile_home / "config.toml").read_text(encoding="utf-8")
            section = re.search(
                r'^\[plugins\."ponytail@ponytail"\]\s*$'
                r"(?P<body>.*?)(?=^\[|\Z)",
                config,
                flags=re.MULTILINE | re.DOTALL,
            )
            if section:
                enabled = re.search(
                    r"^\s*enabled\s*=\s*(true|false)\s*(?:#.*)?$",
                    section.group("body"),
                    flags=re.MULTILINE | re.IGNORECASE,
                )
                if enabled:
                    plugin_enabled = enabled.group(1).lower() == "true"
        else:
            settings = json.loads(
                (profile_home / "settings.json").read_text(encoding="utf-8")
            )
            enabled_plugins = settings.get("enabledPlugins", {})
            if isinstance(enabled_plugins, dict):
                value = enabled_plugins.get("ponytail@ponytail")
                if isinstance(value, bool):
                    plugin_enabled = value
    except (OSError, ValueError, TypeError):
        pass

    return {
        "plugin_enabled": plugin_enabled,
        "policy_active": policy_active,
        "saved_tokens": None,
        "note": "Ponytail changes implementation decisions; avoided code/tokens are not observable from rollout telemetry.",
    }


def observed_tool(report: SessionReport, name: str) -> dict[str, Any]:
    calls = 0
    payload_tokens = 0
    needle = name.lower()
    for tool, count in report.tool_calls.items():
        if needle in tool.lower():
            calls += count
    for tool, tokens in report.tool_payloads.items():
        if needle in tool.lower():
            payload_tokens += tokens
    lower_bound = any(
        needle in tool.lower() for tool in report.programmatic_tool_calls
    )
    return {
        "calls_observed": calls,
        "calls_are_lower_bound": lower_bound,
        "result_tokens_estimate": payload_tokens,
        "saved_tokens": None,
    }


def collect_optimization(report: SessionReport) -> dict[str, Any]:
    return {
        "cache_reuse_exact": {
            "cached_input_tokens": report.total.cached_input_tokens,
            "cache_hit_ratio": report.cache_hit,
            "inner_session_cached_input_tokens": report.inner_usage.cached_input_tokens,
            "inner_session_cache_hit_ratio": report.inner_cache_hit,
        },
        "rtk_savings_estimate": read_rtk_savings(report.cwd),
        "headroom_savings": read_headroom_savings(),
        "serena_activity": observed_tool(report, "serena"),
        "context7_activity": observed_tool(report, "context7"),
        "ponytail": read_ponytail_status(
            report.agent,
            profile_home_for_session(report.path, report.agent),
        ),
        "note": "Savings use different scopes and may overlap; they must not be summed.",
    }


def render_optimization(report: SessionReport) -> None:
    optimization = collect_optimization(report)

    print()
    print(style("OPTIMIZATION", "bold"))
    print(style("Measured values keep their native scope; savings are not additive.", "dim"))
    print("─" * 72)
    print_kv(
        "Cache reused (exact)",
