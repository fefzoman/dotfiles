        "top_commands": dict(report.command_payloads.most_common()),
        "top_files": dict(report.file_payloads.most_common()),
        "calls": [
            {
                "timestamp": c.timestamp,
                "usage": dataclasses.asdict(c.usage),
                "cumulative": dataclasses.asdict(c.cumulative),
                "context_window": c.context_window,
                "context_ratio": c.context_ratio,
                "gap_seconds": c.gap_seconds,
                "cold_reason": c.cold_reason,
                "attributed": {k: round(v) for k, v in c.attributed.items()},
            }
            for c in report.calls
        ],
        "calls_by_fresh_input": [
            {
