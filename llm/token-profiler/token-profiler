    @property
    def fresh_input(self) -> int:
        return max(0, self.total.input_tokens - self.total.cached_input_tokens)

    @property
    def current_context_tokens(self) -> int:
        return self.last.input_tokens

    @property
    def current_context_ratio(self) -> float:
        return (
            self.current_context_tokens / self.context_window
            if self.context_window else 0.0
        )

    @property
    def cache_hit(self) -> float:
        return (
            self.total.cached_input_tokens / self.total.input_tokens
            if self.total.input_tokens else 0.0
        )

    @property
    def inner_fresh_input(self) -> int:
        return max(0, self.inner_usage.input_tokens - self.inner_usage.cached_input_tokens)

    @property
    def inner_cache_hit(self) -> float:
        return (
            self.inner_usage.cached_input_tokens / self.inner_usage.input_tokens
            if self.inner_usage.input_tokens else 0.0
        )


def obj_text(obj: Any) -> str:
    """Flatten user/model-visible textual content while avoiding huge base64."""
    if obj is None:
        return ""
    if isinstance(obj, str):
        return obj
    if isinstance(obj, (int, float, bool)):
        return str(obj)
    if isinstance(obj, list):
        return "\n".join(filter(None, (obj_text(v) for v in obj)))
    if isinstance(obj, dict):
        pieces = []
        for key, value in obj.items():
            if key in {"encrypted_content"}:
                continue
            if key in {"image_url", "audio_url"} and isinstance(value, str) and value.startswith("data:"):
                pieces.append(f"<{key}:inline-data>")
                continue
            pieces.append(obj_text(value))
        return "\n".join(filter(None, pieces))
    return str(obj)


def content_text(content: Any) -> str:
    if not isinstance(content, list):
        return obj_text(content)
    parts: list[str] = []
    for item in content:
        if isinstance(item, dict):
            ty = item.get("type")
            if ty in {"input_text", "output_text", "text"}:
                parts.append(str(item.get("text") or ""))
            elif ty in {"input_image", "output_image"}:
                parts.append("<image>")
            elif "text" in item:
                parts.append(str(item.get("text") or ""))
            else:
                parts.append(obj_text(item))
        else:
            parts.append(obj_text(item))
    return "\n".join(filter(None, parts))


INSTRUCTION_MARKERS = (
    "AGENTS.md instructions for",
    "<INSTRUCTIONS>",
    "<skills_instructions>",
    "<permissions instructions>",
    "<multi_agent_mode>",
    "PONYTAIL MODE ACTIVE",
    "You are `/root`",
    "# AGENTS.md",
    "# CLAUDE.md",
    "developer instructions",
    "system instructions",
)


def looks_like_instructions(text: str) -> bool:
    t = text.lower()
    return any(marker.lower() in t for marker in INSTRUCTION_MARKERS)


def instruction_source(text: str, fallback: str = "Other injected instructions") -> str:
    match = re.search(r"^# AGENTS\.md instructions for (.+)$", text, re.MULTILINE)
    if match:
        return f"AGENTS.md: {match.group(1)}"
    for marker, label in (
        ("PONYTAIL MODE ACTIVE", "Ponytail"),
        ("<skills_instructions>", "Skills catalog"),
        ("<permissions instructions>", "Permissions"),
        ("<multi_agent_mode>", "Multi-agent policy"),
        ("You are `/root`", "Multi-agent orchestration"),
    ):
        if marker.lower() in text.lower():
            return label
    return fallback


def summarize_sources(items: Iterable[SourceItem]) -> dict[str, int]:
    result: dict[str, int] = collections.defaultdict(int)
    for item in items:
        result[item.category] += item.tokens
    return dict(result)


def add_instruction_attribution(
    report: SessionReport,
    items: Iterable[SourceItem],
    scale: float,
) -> None:
    for item in items:
        if item.category == "AGENTS.md/instructions":
            report.instruction_cumulative[item.label] = (
                report.instruction_cumulative.get(item.label, 0.0)
                + item.tokens * scale
            )


def record_tool_result(
    report: SessionReport,
    names: list[str],
    tokens: int,
    timestamp: str = "",
    arguments: Any = None,
) -> None:
    if not names:
        return
    argument_text = obj_text(arguments)
    share, remainder = divmod(tokens, len(names))
    for index, name in enumerate(names):
        size = share + (index < remainder)
        report.tool_payloads[name] = report.tool_payloads.get(name, 0) + size
        report.tool_results.append(ToolResult(timestamp, name, size, argument_text))


def call_diagnostics(
    timestamp: str,
    usage: Usage,
    previous_at: dt.datetime | None,
    post_compaction: bool = False,
) -> tuple[int | None, str]:
    current_at = parse_timestamp(timestamp)
    gap = (
        max(0, round((current_at - previous_at).total_seconds()))
        if current_at and previous_at
        else None
    )
    if previous_at is None:
        return gap, "session start"
    if post_compaction:
        return gap, "post-compaction"
    if gap is not None and gap > INNER_SESSION_GAP.total_seconds():
        return gap, "resume after idle"
    cached = min(usage.cached_input_tokens, usage.input_tokens)
    if usage.input_tokens and cached * 2 < usage.input_tokens:
        return gap, "cache expiry/prefix change"
    return gap, "warm"


TEST_PATTERNS = re.compile(
    r"(^|\s|/)(pytest|python\s+-m\s+pytest|cargo\s+test|go\s+test|npm\s+(run\s+)?test|"
    r"pnpm\s+(run\s+)?test|yarn\s+test|mvn\s+test|gradle\s+test|"
    r"\./gradlew\s+test|dotnet\s+test|rspec|jest|vitest)(\s|$)",
    re.IGNORECASE,
)

FILE_READ_PATTERNS = re.compile(
    r"(^|[;&|]\s*|\s)(cat|sed\s+-n|head|tail|less|more|bat|awk|"
    r"rg|grep|find|fd|git\s+(show|diff)|ls)(\s|$)",
    re.IGNORECASE,
)

FILE_CHANGE_NAMES = {
    "apply_patch", "write_file", "edit_file", "file_change", "patch_file",
}

SHELL_NAMES = {
    "exec_command", "shell", "bash", "sh", "run_command", "terminal",
    "functions.exec", "command",
}


def parse_jsonish(value: Any) -> Any:
    if not isinstance(value, str):
        return value
    s = value.strip()
    if not s:
        return value
    try:
        return json.loads(s)
    except Exception:
        return value


def extract_command(args: Any) -> str | None:
    args = parse_jsonish(args)
    if isinstance(args, dict):
        for key in ("cmd", "command", "script"):
            value = args.get(key)
            if isinstance(value, str):
                return value
            if isinstance(value, list):
                return " ".join(map(str, value))
        # Programmatic calls sometimes nest shell actions.
        for value in args.values():
            cmd = extract_command(value)
            if cmd:
                return cmd
    elif isinstance(args, list):
        if all(isinstance(v, str) for v in args):
            return " ".join(args)
        for value in args:
            cmd = extract_command(value)
            if cmd:
                return cmd
    elif isinstance(args, str):
        match = re.search(r'\bcmd\s*:\s*("(?:\\.|[^"\\])*")', args)
        if match:
            try:
                return json.loads(match.group(1))
            except json.JSONDecodeError:
                pass
        if "tools." in args:
            return None
        # Only accept as a command if it resembles one.
        if re.search(r"(^|\s)(git|cat|sed|rg|grep|pytest|npm|pnpm|yarn|cargo|go|python|terraform|kubectl|docker|make)\b", args):
            return args
    return None


def extract_programmatic_tool_names(args: Any) -> list[str]:
    """Find nested tools invoked through Codex's programmatic exec wrapper."""
    text = args if isinstance(args, str) else obj_text(args)
    return re.findall(r"\btools\.([A-Za-z][A-Za-z0-9_]*)\s*\(", text)


def shell_category(command: str | None) -> str:
    if not command:
        return "Shell command output"
    if TEST_PATTERNS.search(command):
        return "Tests"
    if FILE_READ_PATTERNS.search(command):
        return "Repository/file reads"
    return "Shell command output"


def classify_tool(name: str, command: str | None, is_mcp: bool = False) -> str:
    lower = (name or "").lower()
    if lower in FILE_CHANGE_NAMES or any(
        x in lower for x in ("patch", "edit_file", "write_file", "notebookedit")
    ) or lower in {"edit", "write"}:
        return "File changes"
    if lower in {"read", "glob", "grep"}:
        return "Repository/file reads"
    if is_mcp or (lower == "exec" and not command):
        return "MCP/tool results"
    if lower in SHELL_NAMES or "exec" in lower or command:
        return shell_category(command)
    if "mcp" in lower:
        return "MCP/tool results"
    return "MCP/tool results"


def extract_files_from_command(command: str | None, output: str = "") -> list[str]:
    if not command:
        return []
    files: list[str] = []

    # Common direct file readers.
    operand = r"(?:'([^']+)'|\"([^\"]+)\"|([^\s;&|]+))"
    patterns = [
        rf"\bcat\s+(?:--\s+)?{operand}",
        rf"\b(?:head|tail|less|more|bat)\s+(?:-[^\s]+\s+)*{operand}",
        rf"\bsed\s+-n\s+['\"][^'\"]+['\"]\s+{operand}",
    ]
    for pat in patterns:
        for match in re.findall(pat, command):
            candidate = next((part for part in match if part), "")
            if candidate and not candidate.startswith("-"):
                files.append(candidate)

    # git diff output can identify exact files even when command cannot.
    for match in re.findall(r"^\+\+\+\s+(?:b/)?(.+)$", output, flags=re.MULTILINE):
        if match != "/dev/null":
            files.append(match.strip())

    # ripgrep-style output: path:line:text
    if re.search(r"\b(rg|grep)\b", command):
        for line in output.splitlines()[:5000]:
            m = re.match(r"([^:\n]{1,240}):\d+:", line)
            if m and ("/" in m.group(1) or "." in m.group(1)):
                files.append(m.group(1))

    # Stable order, no duplicates.
    seen = set()
    result = []
    for f in files:
        if f not in seen:
            seen.add(f)
            result.append(f)
    return result[:100]


def session_id_from_path(path: Path) -> str:
    m = re.search(
        r"([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})",
        path.name,
    )
    return m.group(1) if m else path.stem


def iter_rollout(path: Path) -> Iterator[dict[str, Any]]:
    with path.open("r", encoding="utf-8", errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                value = json.loads(line)
                if isinstance(value, dict):
                    yield value
            except json.JSONDecodeError:
                yield {"__parse_error__": True}


def usage_obj_nonzero(u: Usage) -> bool:
    return any(dataclasses.asdict(u).values())


def rollout_has_modern_usage(path: Path) -> bool:
    """Fast pre-scan so legacy token_count and modern token_usage_record are not double-counted."""
    needle = '"type":"token_usage_record"'
    needle_spaced = '"type": "token_usage_record"'
    try:
        with path.open("r", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                if needle in line or needle_spaced in line:
                    return True
    except OSError:
        pass
    return False


def dict_get_first(obj: Any, keys: Iterable[str]) -> Any:
    if isinstance(obj, dict):
        for key in keys:
            value = obj.get(key)
            if value not in (None, "", [], {}):
                return value
        for value in obj.values():
            found = dict_get_first(value, keys)
            if found not in (None, "", [], {}):
                return found
    elif isinstance(obj, list):
        for value in obj:
            found = dict_get_first(value, keys)
            if found not in (None, "", [], {}):
                return found
    return None


def parse_compaction_sources(payload: Any, seq: int) -> list[SourceItem]:
    history = {}
    if isinstance(payload, dict):
        history = payload.get("replacement_history") or payload.get("history") or payload
    text = obj_text(history)
    tok = estimate_tokens(text)
    if not tok:
        return []
    return [
        SourceItem(
            category="Compacted history",
            label="compaction replacement history",
            tokens=tok,
            origin="external",
            kind="compaction",
            seq=seq,
        )
    ]


def analyze_session(path: Path, keep_calls: bool = True) -> SessionReport:
    report = SessionReport(path=path)
    report.session_id = session_id_from_path(path)
    try:
        report.file_size = path.stat().st_size
    except OSError:
        pass

    active: list[SourceItem] = []
    since_last_token: list[SourceItem] = []
    calls_by_id: dict[str, dict[str, Any]] = {}
    previous_total = Usage()
    pending_compaction: Any = None
    previous_model_call_at: dt.datetime | None = None
    last_activity_at: dt.datetime | None = None
    seq = 0

    modern_usage = rollout_has_modern_usage(path)
    if modern_usage:
        report.usage_source = "token_usage_record"
    seen_response_ids: set[str] = set()
    modern_sum = Usage()

    # Prevent repeated turn_context instruction blocks from accumulating as if
    # they were distinct transcript messages.
    instruction_fingerprints: set[int] = set()

    def add_source(item: SourceItem, generator: bool = False, text: str = "") -> None:
        active.append(item)
        since_last_token.append(item)
        report.observed_payload[item.category] = report.observed_payload.get(item.category, 0) + item.tokens
        if item.category == "AGENTS.md/instructions":
            report.instruction_payloads[item.label] = (
                report.instruction_payloads.get(item.label, 0) + item.tokens
            )

        if generator and item.tokens:
            report.generators.append(
                Generator(
                    label=item.label,
                    kind=item.kind,
                    payload_tokens=item.tokens,
                    command=item.command,
                    file=item.file,
                )
            )
        if item.command and item.tokens:
            report.command_payloads[item.command] = report.command_payloads.get(item.command, 0) + item.tokens

        if item.file and item.tokens:
            report.file_payloads[item.file] = report.file_payloads.get(item.file, 0) + item.tokens

        if text and item.command:
            files = extract_files_from_command(item.command, text)
            if files:
                share = max(1, item.tokens // len(files))
                for f in files:
                    report.file_payloads[f] = report.file_payloads.get(f, 0) + share

    def set_compacted_history(payload: Any) -> None:
        nonlocal active, since_last_token
        compacted_sources = parse_compaction_sources(payload, seq)
        active = compacted_sources
        since_last_token = list(compacted_sources)
        for item in compacted_sources:
            report.observed_payload[item.category] = report.observed_payload.get(item.category, 0) + item.tokens

    for rec in iter_rollout(path):
        seq += 1
        if rec.get("__parse_error__"):
            report.parse_errors += 1
            continue

        timestamp = str(rec.get("timestamp") or "")
        if timestamp:
            if not report.started_at:
                report.started_at = timestamp
            report.ended_at = timestamp
            activity_at = parse_timestamp(timestamp)
            if activity_at:
                if last_activity_at is None or activity_at - last_activity_at > INNER_SESSION_GAP:
                    report.inner_started_at = timestamp
                    report.inner_usage = Usage()
                    report.inner_model_calls = 0
                    report.inner_compactions = 0
                last_activity_at = activity_at
                report.inner_ended_at = timestamp

        rtype = rec.get("type")
        payload = rec.get("payload")
        if not isinstance(payload, dict):
            payload = {}

        if rtype == "session_meta":
            report.session_id = str(payload.get("session_id") or payload.get("id") or report.session_id)
            report.cwd = str(payload.get("cwd") or report.cwd)
            report.originator = str(payload.get("originator") or report.originator)
            report.source = str(payload.get("source") or report.source)
            report.cli_version = str(payload.get("cli_version") or report.cli_version)
            report.model_provider = str(payload.get("model_provider") or report.model_provider)
            meta_window = payload.get("context_window") or payload.get("model_context_window")
            if isinstance(meta_window, (int, float)) and meta_window:
                report.context_window = int(meta_window)

            base = payload.get("base_instructions")
            if base:
                text = obj_text(base)
                tok = estimate_tokens(text)
                fp = hash(text)
                if tok and fp not in instruction_fingerprints:
                    instruction_fingerprints.add(fp)
                    add_source(
                        SourceItem(
                            "AGENTS.md/instructions", "Platform base instructions", tok,
                            "external", "instructions", seq
                        )
                    )
            continue

        if rtype == "turn_context":
            report.cwd = str(payload.get("cwd") or report.cwd)
            model = dict_get_first(payload, ("model", "model_name"))
            if model:
                report.model = str(model)
            effort = dict_get_first(payload, ("reasoning_effort", "effort"))
            if effort:
                report.reasoning_effort = str(effort)
            turn_window = dict_get_first(payload, ("model_context_window", "context_window"))
            if isinstance(turn_window, (int, float)) and turn_window:
                report.context_window = int(turn_window)

            # Search common instruction-bearing keys, but deduplicate because
            # turn_context can repeat them many times.
            for key in (
                "developer_instructions", "user_instructions", "instructions",
                "base_instructions", "agent_instructions",
            ):
                value = payload.get(key)
                if value:
                    text = obj_text(value)
                    fp = hash(text)
                    tok = estimate_tokens(text)
                    if tok and fp not in instruction_fingerprints:
                        instruction_fingerprints.add(fp)
                        add_source(
                            SourceItem(
                                "AGENTS.md/instructions",
                                f"turn context: {key}",
                                tok,
                                "external",
                                "instructions",
                                seq,
                            )
                        )
            continue

        if rtype == "token_usage_record":
            if not modern_usage:
                continue

            response_id = str(payload.get("response_id") or f"seq-{seq}")
            if response_id in seen_response_ids:
                continue
            seen_response_ids.add(response_id)

            usage = Usage.from_obj(payload.get("usage")).normalized()
            if not usage_obj_nonzero(usage):
                continue

            modern_sum.add_assign(usage)
            thread_total_obj = payload.get("thread_token_usage")
            thread_total = Usage.from_obj(thread_total_obj).normalized() if isinstance(thread_total_obj, dict) else None

            # Prefer Codex's own cumulative thread total when available. It
            # survives cases where a rollout segment does not contain every
            # historical response record.
            report.total = thread_total if thread_total and usage_obj_nonzero(thread_total) else modern_sum
            report.last = usage
            report.model_calls += 1
            report.inner_usage.add_assign(usage)
            report.inner_model_calls += 1
            gap_seconds, cold_reason = call_diagnostics(
                timestamp,
                usage,
                previous_model_call_at,
                post_compaction=pending_compaction is not None,
            )
            previous_model_call_at = parse_timestamp(timestamp) or previous_model_call_at

            assistant_new_ids = {id(x) for x in since_last_token if x.origin == "assistant"}
            visible = [x for x in active if id(x) not in assistant_new_ids]

            known_by_cat: dict[str, float] = collections.defaultdict(float)
            for item in visible:
                known_by_cat[item.category] += item.tokens

            input_tokens = usage.input_tokens
            known_sum = sum(known_by_cat.values())
            attributed: dict[str, float] = {}
            if input_tokens > 0:
                scale = input_tokens / known_sum if known_sum > input_tokens and known_sum > 0 else 1.0
                known_used = 0.0
                for cat, val in known_by_cat.items():
                    amount = val * scale
                    attributed[cat] = amount
                    known_used += amount
                residual = max(0.0, input_tokens - known_used)
                if residual:
                    attributed["Other/platform context"] = residual

                for cat, amount in attributed.items():
                    report.cumulative_attribution[cat] = (
                        report.cumulative_attribution.get(cat, 0.0) + amount
                    )
                add_instruction_attribution(report, visible, scale)

            if keep_calls:
                report.calls.append(
                    ModelCall(
                        timestamp=timestamp,
                        usage=usage,
                        cumulative=report.total,
                        context_window=report.context_window,
                        context_ratio=(usage.input_tokens / report.context_window if report.context_window else 0.0),
                        attributed=attributed,
                        gap_seconds=gap_seconds,
                        cold_reason=cold_reason,
                    )
                )

            since_last_token = []

            if pending_compaction is not None:
                set_compacted_history(pending_compaction)
                pending_compaction = None
            continue

        if rtype == "compacted":
            report.compactions += 1
            report.inner_compactions += 1
            pending_compaction = payload
            continue

        if rtype == "event_msg":
            ptype = payload.get("type")

            if ptype == "context_compacted":
                # Usually a token_count already occurred immediately after the
                # compacted record. If not, apply the replacement here.
                if pending_compaction is not None:
                    set_compacted_history(pending_compaction)
                    pending_compaction = None
                continue

            if ptype == "token_count":
                info = payload.get("info") or {}
                if not isinstance(info, dict):
                    continue

                cumulative = Usage.from_obj(info.get("total_token_usage"))
                last = Usage.from_obj(info.get("last_token_usage"))
                window = int(info.get("model_context_window") or report.context_window or 0)

                if modern_usage:
                    # Modern per-response records are the accounting source of
                    # truth. Legacy token_count may coexist; use it only to
                    # enrich context-window metadata.
                    if window:
                        report.context_window = window
                    if usage_obj_nonzero(last) and not usage_obj_nonzero(report.last):
                        report.last = last
                    continue

                # Some events can re-emit last_token_usage without new token
                # consumption. Trust increases in cumulative counters first.
                if usage_obj_nonzero(cumulative) and cumulative.increased_from(previous_total):
                    delta = cumulative.delta(previous_total)
                    previous_total = cumulative
                    report.total = cumulative
                    report.last = last if usage_obj_nonzero(last) else delta
                    report.context_window = window
                    report.model_calls += 1
                    report.inner_usage.add_assign(delta)
                    report.inner_model_calls += 1
                    gap_seconds, cold_reason = call_diagnostics(
                        timestamp,
                        delta,
                        previous_model_call_at,
                        post_compaction=pending_compaction is not None,
                    )
                    previous_model_call_at = (
                        parse_timestamp(timestamp) or previous_model_call_at
                    )

                    # The model-generated records since the previous token event
                    # belong to this call's output, not its request input.
                    assistant_new_ids = {id(x) for x in since_last_token if x.origin == "assistant"}
                    visible = [x for x in active if id(x) not in assistant_new_ids]

                    known_by_cat: dict[str, float] = collections.defaultdict(float)
                    for item in visible:
                        known_by_cat[item.category] += item.tokens

                    input_tokens = delta.input_tokens or report.last.input_tokens
                    cached = min(delta.cached_input_tokens, input_tokens)
                    known_sum = sum(known_by_cat.values())

                    attributed: dict[str, float] = {}
                    if input_tokens > 0:
                        if known_sum > input_tokens and known_sum > 0:
                            scale = input_tokens / known_sum
                        else:
                            scale = 1.0
                        known_used = 0.0
                        for cat, val in known_by_cat.items():
                            amount = val * scale
                            attributed[cat] = amount
                            known_used += amount
                        residual = max(0.0, input_tokens - known_used)
                        if residual:
                            attributed["Other/platform context"] = residual

                        for cat, amount in attributed.items():
                            report.cumulative_attribution[cat] = (
                                report.cumulative_attribution.get(cat, 0.0) + amount
                            )
                        add_instruction_attribution(report, visible, scale)

                    if keep_calls:
                        report.calls.append(
                            ModelCall(
                                timestamp=timestamp,
                                usage=delta,
                                cumulative=cumulative,
                                context_window=window,
                                context_ratio=(report.last.input_tokens / window if window else 0.0),
                                attributed=attributed,
                                gap_seconds=gap_seconds,
                                cold_reason=cold_reason,
                            )
                        )

                    since_last_token = []

                    # Apply compaction only after attributing the request that
                    # caused/preceded the compacted history.
                    if pending_compaction is not None:
                        set_compacted_history(pending_compaction)
                        pending_compaction = None

                elif not usage_obj_nonzero(report.total) and usage_obj_nonzero(last):
                    # Legacy/incomplete logs with no cumulative totals.
                    report.last = last
                    report.context_window = window
                continue

            # Avoid event_msg user_message/item_completed duplication. Canonical
            # model-visible messages/tool outputs are handled as response_item.
            continue

        if rtype != "response_item":
            continue

        ptype = str(payload.get("type") or "")

        if ptype == "message":
            role = str(payload.get("role") or "")
            text = content_text(payload.get("content"))
            if not text:
                continue
            tok = estimate_tokens(text)
            if role == "user" and not report.title and not looks_like_instructions(text):
                report.title = truncate(text, 72)

            if looks_like_instructions(text):
                category = "AGENTS.md/instructions"
                label = instruction_source(text)
            else:
                category = "Conversation/history"
                label = f"{role or 'message'}: {truncate(text, 72)}"

            add_source(
                SourceItem(
                    category=category,
                    label=label,
                    tokens=tok,
                    origin="assistant" if role == "assistant" else "external",
                    kind=f"{role or 'unknown'} message",
                    seq=seq,
                ),
                generator=False,
                text=text,
            )
            continue

        if ptype in {"function_call", "custom_tool_call"}:
            call_id = str(payload.get("call_id") or payload.get("id") or f"seq-{seq}")
            name = str(payload.get("name") or payload.get("tool") or "tool")
            args = (
                payload.get("arguments")
                if "arguments" in payload else payload.get("input")
            )
            command = extract_command(args)
            nested_tools = extract_programmatic_tool_names(args) if name == "exec" else []
            effective_tools = nested_tools or (
                ["tool_inventory"]
                if name == "exec" and "ALL_TOOLS" in obj_text(args)
                else [name]
            )
            is_mcp = bool(payload.get("namespace")) and str(payload.get("namespace")).lower() not in {"", "codex_app"}
            calls_by_id[call_id] = {
                "name": name,
                "args": args,
                "command": command,
                "is_mcp": is_mcp,
                "effective_tools": effective_tools,
            }
            for tool_name in effective_tools:
                report.tool_calls[tool_name] = report.tool_calls.get(tool_name, 0) + 1
                if nested_tools:
                    report.programmatic_tool_calls[tool_name] = (
                        report.programmatic_tool_calls.get(tool_name, 0) + 1
                    )

            # Tool-call arguments become part of later context. Keep them small
            # but visible in attribution.
            arg_text = obj_text(args)
            tok = estimate_tokens(arg_text)
            if tok:
                cat = classify_tool(name, command, is_mcp=is_mcp)
                add_source(
                    SourceItem(
                        category=cat,
                        label=f"{name} call: {truncate(command or arg_text, 80)}",
                        tokens=tok,
                        origin="assistant",
                        kind="tool call",
                        seq=seq,
                        command=command,
                    ),
                    generator=False,
                )
            continue

        if ptype in {"function_call_output", "custom_tool_call_output", "tool_search_output"}:
            call_id = str(payload.get("call_id") or payload.get("id") or "")
            meta = calls_by_id.get(call_id, {})
            name = str(payload.get("name") or meta.get("name") or ptype)
            command = meta.get("command")
            output = payload.get("output")
            text = obj_text(output)
            tok = estimate_tokens(text)
            is_mcp = bool(meta.get("is_mcp"))
            category = classify_tool(name, command, is_mcp=is_mcp)
            effective_tools = meta.get("effective_tools") or [name]
            record_tool_result(
                report,
                effective_tools,
                tok,
                timestamp,
                meta.get("args"),
            )
            label_core = truncate(command or ", ".join(dict.fromkeys(effective_tools)), 88)
            label = f"{label_core}"
            add_source(
                SourceItem(
                    category=category,
                    label=label,
                    tokens=tok,
                    origin="external",
                    kind="command output" if command else "tool output",
                    seq=seq,
                    command=command,
                ),
                generator=True,
                text=text,
            )
            continue

        if ptype == "mcp_tool_call":
            name = f"{payload.get('server') or 'mcp'}/{payload.get('tool') or 'tool'}"
            result = payload.get("result")
            if result is None and payload.get("error") is not None:
                result = payload.get("error")
            text = obj_text(result)
            tok = estimate_tokens(text)
            report.tool_calls[name] = report.tool_calls.get(name, 0) + 1
            record_tool_result(
                report,
                [name],
                tok,
                timestamp,
                payload.get("arguments") or payload.get("input"),
            )
            add_source(
                SourceItem(
                    "MCP/tool results", name, tok, "external",
                    "mcp tool output", seq
                ),
                generator=True,
                text=text,
            )
            continue

        if ptype in {"reasoning"}:
            # Reasoning output is measured exactly by token counters; persisted
            # reasoning text/encrypted blobs are not treated as ordinary input
            # attribution because retention semantics vary across Codex versions.
            continue

        # Other response items can still enter retained history. Count only a
        # compact textual representation.
        text = obj_text(payload)
        tok = estimate_tokens(text)
        if tok:
            add_source(
                SourceItem(
                    "Other visible context",
                    ptype or "response item",
                    tok,
                    "assistant",
                    ptype or "response item",
                    seq,
                )
            )

    if pending_compaction is not None:
        set_compacted_history(pending_compaction)

    # If no model/reasoning info was found, scan metadata-like fields cheaply.
    if not report.title:
        report.title = "(no user prompt found)"

    report.active_payload = summarize_sources(active)
    return report


def claude_usage(obj: Any) -> Usage:
    if not isinstance(obj, dict):
        return Usage()
    base_input = int(obj.get("input_tokens") or 0)
    cache_creation = int(obj.get("cache_creation_input_tokens") or 0)
    cache_read = int(obj.get("cache_read_input_tokens") or 0)
    output = int(obj.get("output_tokens") or 0)
    output_details = obj.get("output_tokens_details")
    reasoning = (
        int(output_details.get("thinking_tokens") or 0)
        if isinstance(output_details, dict)
        else 0
    )
    total_input = base_input + cache_creation + cache_read
    return Usage(
        input_tokens=total_input,
        cached_input_tokens=cache_read,
        cache_creation_input_tokens=cache_creation,
        output_tokens=output,
        reasoning_output_tokens=reasoning,
        total_tokens=total_input + output,
    )


def extract_file_argument(args: Any) -> str | None:
    args = parse_jsonish(args)
    if not isinstance(args, dict):
        return None
    for key in ("file_path", "path", "notebook_path"):
        value = args.get(key)
        if isinstance(value, str) and value:
            return value
    return None


def claude_has_compaction_boundaries(path: Path) -> bool:
    try:
        with path.open("r", encoding="utf-8", errors="replace") as fh:
            return any(
                '"compact_boundary"' in line
                for line in fh
                if '"type"' in line
            )
    except OSError:
        return False


def recalculate_inner_session(report: SessionReport) -> None:
    report.inner_started_at = ""
    report.inner_ended_at = ""
    report.inner_usage = Usage()
    report.inner_model_calls = 0
    report.inner_compactions = 0
    last_activity_at: dt.datetime | None = None

    for event in sorted(report.activity_events, key=lambda item: item.timestamp):
        activity_at = parse_timestamp(event.timestamp)
        if not activity_at:
            continue
        if last_activity_at is None or activity_at - last_activity_at > INNER_SESSION_GAP:
            report.inner_started_at = event.timestamp
            report.inner_usage = Usage()
            report.inner_model_calls = 0
            report.inner_compactions = 0
        last_activity_at = activity_at
        report.inner_ended_at = event.timestamp
        if event.usage is not None:
            report.inner_usage.add_assign(event.usage)
            report.inner_model_calls += 1
        if event.compaction:
            report.inner_compactions += 1


def add_report_totals(target: SessionReport, source: SessionReport) -> None:
    target.total.add_assign(source.total)
    target.model_calls += source.model_calls
    target.compactions += source.compactions
    target.parse_errors += source.parse_errors
    target.file_size += source.file_size
    target.calls.extend(source.calls)
    target.generators.extend(source.generators)
    target.tool_results.extend(source.tool_results)
    target.activity_events.extend(source.activity_events)

    for attribute in (
        "cumulative_attribution",
        "observed_payload",
        "active_payload",
        "instruction_payloads",
        "instruction_cumulative",
        "command_payloads",
        "file_payloads",
        "tool_calls",
        "programmatic_tool_calls",
        "tool_payloads",
    ):
        destination = getattr(target, attribute)
        for key, value in getattr(source, attribute).items():
            destination[key] = destination.get(key, 0) + value

def analyze_claude_session(
    path: Path,
    keep_calls: bool = True,
    include_subagents: bool = True,
) -> SessionReport:
    report = SessionReport(
        path=path,
        agent="claude",
        profile="claude",
        session_id=session_id_from_path(path),
        source="Claude Code",
        usage_source="assistant message usage",
    )
    try:
        report.file_size = path.stat().st_size
    except OSError:
        pass

    active: list[SourceItem] = []
    calls_by_id: dict[str, dict[str, Any]] = {}
    seen_message_ids: set[str] = set()
    last_activity_at: dt.datetime | None = None
    previous_model_call_at: dt.datetime | None = None
    post_compaction = False
    has_compaction_boundaries = claude_has_compaction_boundaries(path)
    seq = 0

    def add_source(item: SourceItem, generator: bool = False, text: str = "") -> None:
        active.append(item)
        report.observed_payload[item.category] = (
            report.observed_payload.get(item.category, 0) + item.tokens
        )
        if item.category == "AGENTS.md/instructions":
            report.instruction_payloads[item.label] = (
                report.instruction_payloads.get(item.label, 0) + item.tokens
            )
        if generator and item.tokens:
            report.generators.append(
                Generator(
                    label=item.label,
                    kind=item.kind,
                    payload_tokens=item.tokens,
                    command=item.command,
                    file=item.file,
                )
            )
        if item.command and item.tokens:
            report.command_payloads[item.command] = (
                report.command_payloads.get(item.command, 0) + item.tokens
            )
        if item.file and item.tokens:
            report.file_payloads[item.file] = (
                report.file_payloads.get(item.file, 0) + item.tokens
            )
        if text and item.command:
            files = extract_files_from_command(item.command, text)
            if files:
                share = max(1, item.tokens // len(files))
                for file_name in files:
                    report.file_payloads[file_name] = (
                        report.file_payloads.get(file_name, 0) + share
                    )

    def record_usage(timestamp: str, usage: Usage) -> None:
        nonlocal previous_model_call_at, post_compaction
        report.total.add_assign(usage)
        report.last = usage
        report.model_calls += 1
        report.inner_usage.add_assign(usage)
        report.inner_model_calls += 1
        gap_seconds, cold_reason = call_diagnostics(
            timestamp, usage, previous_model_call_at, post_compaction
        )
        previous_model_call_at = parse_timestamp(timestamp) or previous_model_call_at
        post_compaction = False

        known_by_category: dict[str, float] = collections.defaultdict(float)
        for item in active:
            known_by_category[item.category] += item.tokens
        known_sum = sum(known_by_category.values())
        attributed: dict[str, float] = {}
        if usage.input_tokens:
            scale = (
                usage.input_tokens / known_sum
                if known_sum > usage.input_tokens and known_sum
                else 1.0
            )
            known_used = 0.0
            for category, value in known_by_category.items():
                amount = value * scale
                attributed[category] = amount
                known_used += amount
            residual = max(0.0, usage.input_tokens - known_used)
            if residual:
                attributed["Other/platform context"] = residual
            for category, amount in attributed.items():
                report.cumulative_attribution[category] = (
                    report.cumulative_attribution.get(category, 0.0) + amount
                )
            add_instruction_attribution(report, active, scale)

        if keep_calls:
            report.calls.append(
                ModelCall(
                    timestamp=timestamp,
                    usage=usage,
                    cumulative=dataclasses.replace(report.total),
                    context_window=report.context_window,
                    context_ratio=(
                        usage.input_tokens / report.context_window
                        if report.context_window
                        else 0.0
                    ),
                    attributed=attributed,
                    gap_seconds=gap_seconds,
                    cold_reason=cold_reason,
                )
            )

    for rec in iter_rollout(path):
        seq += 1
        if rec.get("__parse_error__"):
            report.parse_errors += 1
            continue

        timestamp = str(rec.get("timestamp") or "")
        if timestamp:
            if not report.started_at:
                report.started_at = timestamp
            report.ended_at = timestamp
            activity_at = parse_timestamp(timestamp)
            if activity_at:
                if last_activity_at is None or activity_at - last_activity_at > INNER_SESSION_GAP:
                    report.inner_started_at = timestamp
                    report.inner_usage = Usage()
                    report.inner_model_calls = 0
                    report.inner_compactions = 0
                last_activity_at = activity_at
                report.inner_ended_at = timestamp
            report.activity_events.append(ActivityEvent(timestamp))

        report.session_id = str(rec.get("sessionId") or report.session_id)
        report.cwd = str(rec.get("cwd") or report.cwd)
        report.cli_version = str(rec.get("version") or report.cli_version)
        record_type = str(rec.get("type") or "")

        if record_type == "system" and rec.get("subtype") == "compact_boundary":
            report.compactions += 1
            report.inner_compactions += 1
            post_compaction = True
            if timestamp:
                report.activity_events.append(ActivityEvent(timestamp, compaction=True))
            active = []
            continue

        if record_type == "summary":
            if not has_compaction_boundaries:
                report.compactions += 1
                report.inner_compactions += 1
                post_compaction = True
                if timestamp:
                    report.activity_events.append(ActivityEvent(timestamp, compaction=True))
            summary = str(rec.get("summary") or "")
            tokens = estimate_tokens(summary)
            active = []
            if tokens:
                add_source(
                    SourceItem(
                        "Compacted history",
                        "Claude compacted history",
                        tokens,
                        "external",
                        "compaction",
                        seq,
                    )
                )
            continue

        message = rec.get("message")
        if not isinstance(message, dict):
            continue
        content = message.get("content")

        if record_type == "assistant":
            message_id = str(message.get("id") or rec.get("uuid") or f"seq-{seq}")
            if message_id in seen_message_ids:
                continue
            seen_message_ids.add(message_id)
            report.model = str(message.get("model") or report.model)
            context_window = dict_get_first(message.get("usage"), ("context_window",))
            if isinstance(context_window, (int, float)) and context_window:
                report.context_window = int(context_window)
            usage = claude_usage(message.get("usage"))
            if usage_obj_nonzero(usage):
                record_usage(timestamp, usage)
                if timestamp:
                    report.activity_events.append(ActivityEvent(timestamp, usage=usage))

            blocks = content if isinstance(content, list) else [{"type": "text", "text": content}]
            for block in blocks:
                if not isinstance(block, dict):
                    continue
                block_type = str(block.get("type") or "")
                if block_type in {"text", "thinking"}:
                    if block_type == "thinking":
                        continue
                    text = str(block.get("text") or "")
                    tokens = estimate_tokens(text)
                    if tokens:
                        add_source(
                            SourceItem(
                                "Conversation/history",
                                f"assistant: {truncate(text, 72)}",
                                tokens,
                                "assistant",
                                "assistant message",
                                seq,
                            )
                        )
                    continue
                if block_type != "tool_use":
                    continue
                call_id = str(block.get("id") or f"seq-{seq}")
                name = str(block.get("name") or "tool")
                args = block.get("input")
                command = extract_command(args)
                file_name = extract_file_argument(args)
                calls_by_id[call_id] = {
                    "name": name,
                    "args": args,
                    "command": command,
                    "file": file_name,
                }
                report.tool_calls[name] = report.tool_calls.get(name, 0) + 1
                arg_text = obj_text(args)
                tokens = estimate_tokens(arg_text)
                if tokens:
                    add_source(
                        SourceItem(
                            classify_tool(name, command, is_mcp="mcp" in name.lower()),
                            f"{name} call: {truncate(command or file_name or arg_text, 80)}",
                            tokens,
                            "assistant",
                            "tool call",
                            seq,
                            command=command,
                            file=file_name,
                        )
                    )
            continue

        if record_type != "user":
            continue
        blocks = content if isinstance(content, list) else [{"type": "text", "text": content}]
        for block in blocks:
            if not isinstance(block, dict):
                continue
            block_type = str(block.get("type") or "")
            if block_type == "tool_result":
                call_id = str(block.get("tool_use_id") or "")
                meta = calls_by_id.get(call_id, {})
                name = str(meta.get("name") or "tool_result")
                command = meta.get("command")
                file_name = meta.get("file")
                text = obj_text(block.get("content"))
                tokens = estimate_tokens(text)
                record_tool_result(
                    report,
                    [name],
                    tokens,
                    timestamp,
                    meta.get("args"),
                )
                add_source(
                    SourceItem(
                        classify_tool(name, command, is_mcp="mcp" in name.lower()),
                        truncate(command or file_name or name, 88),
                        tokens,
                        "external",
                        "command output" if command else "tool output",
                        seq,
                        command=command,
                        file=file_name,
                    ),
                    generator=True,
                    text=text,
                )
                continue
            if block_type != "text":
                continue
            text = str(block.get("text") or "")
            if not text:
                continue
            if not report.title and not looks_like_instructions(text):
                report.title = truncate(text, 72)
            category = (
                "AGENTS.md/instructions"
                if looks_like_instructions(text)
                else "Conversation/history"
            )
            add_source(
                SourceItem(
                    category,
                    instruction_source(text)
                    if category == "AGENTS.md/instructions"
                    else f"user: {truncate(text, 72)}",
                    estimate_tokens(text),
                    "external",
                    "user message",
                    seq,
                )
            )

    report.active_payload = summarize_sources(active)
    if not report.title:
        report.title = "(no user prompt found)"
    if include_subagents and "subagents" not in path.parts:
        subagent_root = path.with_suffix("") / "subagents"
        if subagent_root.is_dir():
            for subagent_path in sorted(subagent_root.rglob("*.jsonl")):
                previous_end = parse_timestamp(report.ended_at)
                subagent = analyze_claude_session(
                    subagent_path,
                    keep_calls=keep_calls,
                    include_subagents=False,
                )
                subagent_end = parse_timestamp(subagent.ended_at)
                add_report_totals(report, subagent)
                report.subagent_sessions += 1
                if subagent.started_at and (
                    not report.started_at or subagent.started_at < report.started_at
                ):
                    report.started_at = subagent.started_at
                if subagent.ended_at and (
                    not report.ended_at or subagent.ended_at > report.ended_at
                ):
                    report.ended_at = subagent.ended_at
                if subagent_end and (not previous_end or subagent_end > previous_end):
                    report.last = subagent.last
                    if subagent.model:
                        report.model = subagent.model
    recalculate_inner_session(report)
    return report


