def cold_causes(calls: Iterable[ModelCall]) -> list[tuple[str, tuple[int, int]]]:
    causes: dict[str, list[int]] = collections.defaultdict(lambda: [0, 0])
    for call in calls:
        if call.cold_reason != "warm":
            causes[call.cold_reason][0] += 1
            causes[call.cold_reason][1] += call.usage.fresh_input_tokens
    return sorted(((r, (c, f)) for r, (c, f) in causes.items()), key=lambda item: item[1][1], reverse=True)


