        "tool_result_outliers": tool_result_outliers(report),
        "model_call_windows": model_call_windows(report),
        "top_generators": [
            dataclasses.asdict(x)
            for x in sorted(report.generators, key=lambda x: x.payload_tokens, reverse=True)
