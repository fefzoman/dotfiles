        print(f"{name:<27} {human_int(value):>9}  {pct(value, total_attr):>6}  {render_bar(value, max_val)}")

    render_payload_breakdown(
        "HISTORICAL PAYLOAD — seen once across the full transcript",
        "Cumulative ingestion; classification changes can move tokens between categories.",
        report.observed_payload,
    )
    render_payload_breakdown(
        "CURRENT ACTIVE PAYLOAD — retained after the latest compaction",
        "Estimated model-visible transcript items still active at session end.",
        report.active_payload,
    )
    compacted_away = payload_difference(report.observed_payload, report.active_payload)
    if compacted_away:
        render_payload_breakdown(
            "COMPACTED-AWAY PAYLOAD — historical minus current active",
            "Estimated payload removed from active history by compaction.",
            compacted_away,
        )

    if report.instruction_payloads:
        print()
        print(style("INSTRUCTION SOURCES — estimated", "bold"))
        print("─" * 72)
        print(f"{'source':<42} {'once':>9} {'cumulative':>11}")
        for name, tokens in report.instruction_payloads.most_common():
            print(
                f"{truncate(name, 41):<42} {human_int(tokens):>9} "
                f"{human_int(report.instruction_cumulative.get(name, 0)):>11}"
            )

    print()
    print(style("TOP TOKEN GENERATORS — estimated model-visible payload", "bold"))
    print("─" * 72)
    generators = sorted(report.generators, key=lambda x: x.payload_tokens, reverse=True)[:top_n]
    if not generators:
        print("(no tool outputs found)")
    else:
        for i, gen in enumerate(generators, 1):
            print(f"{i:>2}. {human_int(gen.payload_tokens):>8}  {gen.kind:<15}  {truncate(gen.label, 88)}")

    stats = tool_statistics(report)
    if stats:
        print()
        print(style("TOOL RESULT BREAKDOWN — estimated", "bold"))
        print(style("Programmatic loop call counts are lower bounds; payload is split across nested tool sites.", "dim"))
        print("─" * 96)
        print(f"{'tool':<44} {'calls':>7} {'total':>9} {'avg':>8} {'max':>8} {'share':>7}")
        for row in stats[:top_n]:
            calls = f"{'≥' if row['calls_are_lower_bound'] else ''}{row['calls']}"
            print(
                f"{truncate(row['name'], 43):<44} {calls:>7} "
                f"{human_int(row['result_tokens']):>9} "
                f"{human_int(row['average_result_tokens']):>8} "
                f"{human_int(row['max_result_tokens']):>8} "
                f"{row['payload_ratio'] * 100:>6.1f}%"
            )

    outliers = tool_result_outliers(report)
    if outliers:
        print()
        print(style(f"TOOL RESULT OUTLIERS — >2K tokens, top {min(top_n, len(outliers))}", "bold"))
        print("─" * 96)
        for row in outliers[:top_n]:
            repeated = (
                f" repeat #{row['occurrence']}" if row["occurrence"] > 1 else ""
            )
            print(
                f"{human_int(row['tokens']):>8}  {truncate(row['tool'], 40):<41} "
                f"{row['timestamp'].replace('T', ' ')[:19]}{repeated}"
            )
            print(f"          args: {truncate(row['arguments'] or '-', 106)}")

    if report.file_payloads:
        print()
        print(style("TOP FILES — inferred from read/diff commands", "bold"))
        print("─" * 72)
        for i, (name, tokens) in enumerate(report.file_payloads.most_common()[:top_n], 1):
            print(f"{i:>2}. {human_int(tokens):>8}  {truncate(name, 100)}")

    if report.command_payloads:
        print()
        print(style("TOP COMMANDS — by returned model-visible output", "bold"))
        print("─" * 72)
        for i, (cmd, tokens) in enumerate(report.command_payloads.most_common()[:top_n], 1):
            print(f"{i:>2}. {human_int(tokens):>8}  {truncate(cmd, 105)}")

    if show_calls and report.calls:
        render_cold_calls(report, show_calls)
        render_model_call_windows(report)
        render_model_calls(
            report,
            show_calls,
            "LARGEST MODEL CALLS BY TOTAL INPUT",
            lambda call: call.usage.input_tokens,
        )
        render_model_calls(
            report,
            show_calls,
            "LARGEST MODEL CALLS BY FRESH INPUT",
            lambda call: call.usage.input_tokens - call.usage.cached_input_tokens,
        )

    render_optimization(report)

    print()
    print(style("NOTES", "bold"))
    print("─" * 72)
    if report.agent == "codex":
        print("• Exact usage comes from Codex token counters.")
    else:
        print("• Exact usage is summed from Claude assistant-message usage records.")
        print("• Claude input includes base input, cache creation, and cache reads.")
    print("• Cached input is a subset of total input; it is not added on top.")
    print("• Reasoning output is reported separately but is already part of output accounting semantics.")
    print("• Activity/file/command figures are estimates and should be used for optimization, not billing.")


def render_short_report(report: SessionReport) -> None:
    model = " / ".join(filter(None, [report.model or "-", report.reasoning_effort]))
    context = "-"
    if report.context_window:
        context = (
            f"{human_int(report.current_context_tokens)} / "
            f"{human_int(report.context_window)} ({report.current_context_ratio * 100:.1f}%)"
        )
    elif report.current_context_tokens:
        context = human_int(report.current_context_tokens)

    print(style(f"{report.agent.upper()} TOKEN PROFILE — SHORT", "bold", "cyan"))
    print("─" * 72)
    print_kv("Profile", report.profile)
    print_kv("Session", report.session_id)
    print_kv("Project", report.cwd or "-")
    print_kv("Model", model)
    print_kv(
        "Input",
        f"{human_int(report.total.input_tokens)} "
        f"({human_int(report.total.cached_input_tokens)} cached, {human_int(report.total.fresh_input_tokens)} fresh)",
    )
    if report.total.cache_creation_input_tokens:
        print_kv("Cache creation", human_int(report.total.cache_creation_input_tokens))
    print_kv(
        "Output",
        f"{human_int(report.total.output_tokens)} "
        f"({human_int(report.total.reasoning_output_tokens)} reasoning)",
    )
    print_kv("Current context", context)
    print_kv("Calls / compactions", f"{report.model_calls} / {report.compactions}")
    if report.subagent_sessions:
        print_kv("Subagent sessions", str(report.subagent_sessions))
    print_kv(
        "Inner session (exact)",
        f"{human_int(report.inner_usage.input_tokens)} in / "
        f"{human_int(report.inner_usage.output_tokens)} out, "
        f"{report.inner_model_calls} calls, "
        f"{human_duration(report.inner_started_at, report.inner_ended_at)}",
    )

    activities = ordered_items(report.cumulative_attribution)[:3]
    if activities:
        summary = ", ".join(f"{name}: {human_int(value)}" for name, value in activities)
        print_kv("Top activity (est.)", summary)
    optimization = collect_optimization(report)
    rtk_savings = optimization["rtk_savings_estimate"]
    if rtk_savings:
        print_kv(
            "RTK saved (est.)",
            f"{human_int(rtk_savings['saved_tokens_estimate'])} "
            f"({rtk_savings['average_savings_percent']:.1f}%, {rtk_savings['commands']} commands)",
        )
    print_kv(
        "Tools observed",
        f"Serena {optimization['serena_activity']['calls_observed']}, "
        f"Context7 {optimization['context7_activity']['calls_observed']}",
    )
    print_kv("Ponytail", f"{ponytail_status(optimization['ponytail'])}; savings not measurable")
    if report.parse_errors:
        print_kv("JSON parse errors", style(str(report.parse_errors), "yellow"))


