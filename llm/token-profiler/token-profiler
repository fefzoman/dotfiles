def render_sessions(profile: Profile, limit: int, include_archived: bool) -> None:
    paths = discover_sessions(profile, include_archived=include_archived)[:limit]
    if not paths:
        raise SystemExit(f"No {profile.agent} session files found under {profile.home}")

    print(style(f"RECENT {profile.agent.upper()} SESSIONS — {profile.home}", "bold", "cyan"))
    print("─" * 118)
    print(f"{'session':<14} {'project':<28} {'input':>9} {'cached':>9} {'output':>8} {'calls':>6} {'ctx':>7}  title")
    for path in paths:
        r = analyze_profile_session(path, profile, keep_calls=False)
        short_id = r.session_id[:12]
        project = Path(r.cwd).name if r.cwd else "-"
        ctx = f"{r.current_context_ratio * 100:.0f}%" if r.context_window else "-"
        print(
            f"{short_id:<14} {truncate(project, 27):<28} "
            f"{human_int(r.total.input_tokens):>9} {human_int(r.total.cached_input_tokens):>9} "
            f"{human_int(r.total.output_tokens):>8} {r.model_calls:>6} {ctx:>7}  "
            f"{truncate(r.title, 46)}"
        )


def render_top(profile: Profile, by: str, limit: int, sessions: int, include_archived: bool) -> None:
    paths = discover_sessions(profile, include_archived=include_archived)[:sessions]
    if not paths:
        raise SystemExit(f"No {profile.agent} session files found under {profile.home}")

    if by == "session":
        rows = []
        for path in paths:
            r = analyze_profile_session(path, profile, keep_calls=False)
            rows.append((r.total.input_tokens, r))
        rows.sort(key=lambda x: x[0], reverse=True)
        print(style(f"TOP SESSIONS BY INPUT TOKENS — scanned {len(paths)}", "bold", "cyan"))
        print("─" * 110)
        for i, (_, r) in enumerate(rows[:limit], 1):
            print(
                f"{i:>2}. {human_int(r.total.input_tokens):>9}  "
                f"{r.session_id[:12]:<12}  {truncate(Path(r.cwd).name if r.cwd else '-', 24):<24}  "
                f"{truncate(r.title, 58)}"
            )
        return

    aggregate: dict[str, int] = collections.defaultdict(int)
    for path in paths:
        r = analyze_profile_session(path, profile, keep_calls=False)
        source = r.command_payloads if by == "command" else r.file_payloads
        for key, value in source.items():
            aggregate[key] += value

    print(style(f"TOP {by.upper()}S — estimated payload across {len(paths)} sessions", "bold", "cyan"))
    print("─" * 110)
    for i, (name, tokens) in enumerate(
        sorted(aggregate.items(), key=lambda kv: kv[1], reverse=True)[:limit], 1
    ):
        print(f"{i:>2}. {human_int(tokens):>9}  {truncate(name, 100)}")


# ----------------------------- CLI -----------------------------

def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="token-profiler",
        description="Profile local Codex and Claude Code token usage.",
    )
    p.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")

    profiles = p.add_subparsers(dest="profile", required=True)
    for profile_name in ("codex", "codex-work", "claude", "claude-work"):
        profile_parser = profiles.add_parser(
            profile_name,
            help=f"Profile {profile_name} sessions.",
        )
        profile_parser.add_argument(
            "--home",
            type=Path,
            help="Override this profile's session directory.",
        )
        actions = profile_parser.add_subparsers(dest="command")

        current = actions.add_parser("current", help="Analyze the newest local session.")
        current.add_argument("--json", action="store_true", help="Emit JSON.")
        current.add_argument("--top", type=int, default=8, help="Top generators/files/commands.")
        current.add_argument("--calls", type=int, default=10, help="Number of largest model calls.")

        actions.add_parser("short", help="Show a compact report for the newest local session.")

        session = actions.add_parser("session", help="Analyze a session ID/prefix or JSONL path.")
        session.add_argument("selector", help="Session ID/prefix or JSONL path.")
        session.add_argument("--json", action="store_true", help="Emit JSON.")
        session.add_argument("--top", type=int, default=8)
        session.add_argument("--calls", type=int, default=10)

        sessions_parser = actions.add_parser("sessions", help="List recent sessions.")
        sessions_parser.add_argument("--limit", type=int, default=20)
        sessions_parser.add_argument("--archived", action="store_true")

        top = actions.add_parser("top", help="Rank usage across recent sessions.")
        top.add_argument("--by", choices=("session", "command", "file"), default="session")
        top.add_argument("--limit", type=int, default=15)
        top.add_argument("--sessions", type=int, default=50, help="How many recent sessions to scan.")
        top.add_argument("--archived", action="store_true")

    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    profile = profile_for(args.profile, args.home)

    command = args.command or "current"

    if command == "current":
        path = resolve_session(None, profile, include_archived=False)
        r = analyze_profile_session(path, profile)
        if getattr(args, "json", False):
            print(json.dumps(report_to_json(r), indent=2, ensure_ascii=False))
        else:
            render_report(r, top_n=getattr(args, "top", 8), show_calls=getattr(args, "calls", 10))
        return 0

    if command == "short":
        path = resolve_session(None, profile, include_archived=False)
        render_short_report(analyze_profile_session(path, profile, keep_calls=False))
        return 0

    if command == "session":
        path = resolve_session(args.selector, profile, include_archived=True)
        r = analyze_profile_session(path, profile)
        if args.json:
            print(json.dumps(report_to_json(r), indent=2, ensure_ascii=False))
        else:
            render_report(r, top_n=args.top, show_calls=args.calls)
        return 0

    if command == "sessions":
        render_sessions(profile, args.limit, args.archived)
        return 0

    if command == "top":
        render_top(profile, args.by, args.limit, args.sessions, args.archived)
        return 0

    parser.print_help()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
