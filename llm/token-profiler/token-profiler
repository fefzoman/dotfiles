@dataclasses.dataclass(frozen=True)
class Profile:
    name: str
    agent: str
    home: Path


def profile_for(name: str, home: Path | None = None) -> Profile:
    if name not in {"codex", "codex-work", "claude", "claude-work"}:
        raise ValueError(f"Unknown profile: {name}")
    agent = name.split("-", 1)[0]
    configured_home = Path.home() / f".{name}"
    return Profile(name=name, agent=agent, home=(home or configured_home).expanduser())


def profile_home_for_session(path: Path, agent: str) -> Path:
    root_names = {"sessions", "archived_sessions"} if agent == "codex" else {"projects"}
    for parent in path.parents:
        if parent.name in root_names:
            return parent.parent
    return Path.home() / f".{agent}"


def discover_sessions(profile: Profile, include_archived: bool = False) -> list[Path]:
    if profile.agent == "codex":
        roots = [profile.home / "sessions"]
        if include_archived:
            roots.append(profile.home / "archived_sessions")
        pattern = "rollout-*.jsonl"
    else:
        roots = [profile.home / "projects"]
        pattern = "*.jsonl"

    paths: list[Path] = []
    for root in roots:
        if root.exists():
            discovered = root.rglob(pattern)
            if profile.agent == "claude":
                discovered = (path for path in discovered if "subagents" not in path.parts)
            paths.extend(discovered)
    return sorted(
        paths,
        key=lambda p: p.stat().st_mtime if p.exists() else 0,
        reverse=True,
    )


def has_claude_reply(path: Path) -> bool:
    with path.open(encoding="utf-8", errors="replace") as handle:
        for line in handle:
            if "assistant" not in line:
                continue
            try:
                if json.loads(line).get("type") == "assistant":
                    return True
            except (json.JSONDecodeError, AttributeError):
                continue
    return False


def resolve_session(value: str | None, profile: Profile, include_archived: bool = True) -> Path:
    if value:
        direct = Path(os.path.expanduser(value))
        if direct.exists():
            return direct

    sessions = discover_sessions(profile, include_archived=include_archived)
    if not sessions:
        raise SystemExit(f"No {profile.agent} session files found under {profile.home}")

    if not value or value in {"current", "latest"}:
        if profile.agent == "claude":
            return next((p for p in sessions if has_claude_reply(p)), sessions[0])
        return sessions[0]

    matches = [p for p in sessions if value.lower() in p.name.lower()] or [
        p for p in sessions if value.lower() in session_id_from_path(p).lower()
    ]

    if not matches:
        raise SystemExit(f"No session matching {value!r} under {profile.home}")
    if len(matches) > 1:
        exact = [p for p in matches if session_id_from_path(p) == value]
        if len(exact) == 1:
            return exact[0]
        raise SystemExit(
            f"Session selector {value!r} is ambiguous ({len(matches)} matches). "
            "Use a longer UUID prefix."
        )
    return matches[0]


def analyze_profile_session(
    path: Path,
    profile: Profile,
    keep_calls: bool = True,
) -> SessionReport:
    report = (
        analyze_session(path, keep_calls=keep_calls)
        if profile.agent == "codex"
        else analyze_claude_session(path, keep_calls=keep_calls)
    )
    report.agent = profile.agent
    report.profile = profile.name
    return report


