CATEGORY_ORDER = [
    "Repository/file reads",
    "Shell command output",
    "Tests",
    "MCP/tool results",
    "File changes",
    "Conversation/history",
    "Reasoning/thinking",
    "AGENTS.md/instructions",
    "Platform reminders",
