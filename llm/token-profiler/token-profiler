# ----------------------------- formatting -----------------------------

ANSI = {
    "bold": "\033[1m",
    "dim": "\033[2m",
    "cyan": "\033[36m",
    "yellow": "\033[33m",
    "red": "\033[31m",
    "green": "\033[32m",
    "reset": "\033[0m",
}


def supports_color() -> bool:
    return sys.stdout.isatty() and os.getenv("NO_COLOR") is None


def style(text: str, *names: str) -> str:
    if not supports_color():
        return text
    return "".join(ANSI[n] for n in names) + text + ANSI["reset"]


def human_int(n: int | float | None) -> str:
    if n is None:
        return "-"
    n = float(n)
    sign = "-" if n < 0 else ""
    n = abs(n)
    if n >= 1_000_000_000:
        return f"{sign}{n / 1_000_000_000:.2f}B"
    if n >= 1_000_000:
        return f"{sign}{n / 1_000_000:.2f}M"
    if n >= 1_000:
        return f"{sign}{n / 1_000:.1f}K"
    return f"{sign}{int(n):,}"


def human_bytes(n: int) -> str:
    value = float(n)
    for suffix in ("B", "KiB", "MiB", "GiB", "TiB"):
        if value < 1024 or suffix == "TiB":
            return f"{value:.1f} {suffix}"
        value /= 1024
    return f"{n} B"


def pct(num: int | float, den: int | float) -> str:
    if not den:
        return "-"
    return f"{100.0 * num / den:.1f}%"


def truncate(s: str, width: int = 88) -> str:
    s = " ".join(str(s).split())
    if len(s) <= width:
        return s
    return s[: max(0, width - 1)] + "…"


def print_kv(label: str, value: str, width: int = 24) -> None:
    print(f"{label:<{width}} {value}")


def parse_timestamp(value: str) -> dt.datetime | None:
    if not value:
        return None
    try:
        parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
        return parsed if parsed.tzinfo else parsed.replace(tzinfo=dt.timezone.utc)
    except ValueError:
        return None


def human_duration(start: str, end: str) -> str:
    return human_seconds(duration_seconds(start, end))


def duration_seconds(start: str, end: str) -> int | None:
    start_at = parse_timestamp(start)
    end_at = parse_timestamp(end)
    if not start_at or not end_at:
        return None
    return max(0, int((end_at - start_at).total_seconds()))


def human_seconds(seconds: int | None) -> str:
    if seconds is None:
        return "-"
    hours, remainder = divmod(seconds, 3600)
    minutes, seconds = divmod(remainder, 60)
    if hours:
        return f"{hours}h {minutes}m"
    if minutes:
        return f"{minutes}m {seconds}s"
    return f"{seconds}s"


# ----------------------------- token estimation -----------------------------

_ENCODING = None


def estimate_tokens(value: Any) -> int:
    """Estimate visible text with tiktoken's o200k_base encoding."""
    if value is None:
        return 0
    if not isinstance(value, str):
        try:
            value = json.dumps(value, ensure_ascii=False, separators=(",", ":"))
        except Exception:
            value = str(value)

    # Inline images are not meaningfully tokenized by text length. Count only
    # a small placeholder so base64 does not dominate text attribution.
    value = re.sub(
        r"data:image/[^;]+;base64,[A-Za-z0-9+/=\s]{128,}",
        "<inline-image>",
        value,
        flags=re.MULTILINE,
    )

    global _ENCODING
    if _ENCODING is None:
        _ENCODING = tiktoken.get_encoding("o200k_base")
    return len(_ENCODING.encode(value))


# ----------------------------- rollout model -----------------------------

@dataclasses.dataclass
class Usage:
    input_tokens: int = 0
    cached_input_tokens: int = 0
    cache_creation_input_tokens: int = 0
    output_tokens: int = 0
    reasoning_output_tokens: int = 0
    total_tokens: int = 0

    @classmethod
    def from_obj(cls, obj: dict[str, Any] | None) -> "Usage":
        obj = obj or {}
        return cls(*(int(obj.get(field.name) or 0) for field in dataclasses.fields(cls)))

    def delta(self, previous: "Usage") -> "Usage":
        return Usage(*(max(0, a - b) for a, b in zip(dataclasses.astuple(self), dataclasses.astuple(previous))))

    def increased_from(self, previous: "Usage") -> bool:
        return any([
            self.input_tokens > previous.input_tokens,
            self.output_tokens > previous.output_tokens,
            self.total_tokens > previous.total_tokens,
        ])

    def add_assign(self, other: "Usage") -> None:
        for field in dataclasses.fields(self):
            setattr(self, field.name, getattr(self, field.name) + getattr(other, field.name))
        if not other.total_tokens:
            self.total_tokens += other.input_tokens + other.output_tokens

    @property
    def fresh_input_tokens(self) -> int:
        return max(0, self.input_tokens - self.cached_input_tokens)

    @property
    def cache_hit(self) -> float:
        return self.cached_input_tokens / self.input_tokens if self.input_tokens else 0.0

    def normalized(self) -> "Usage":
        if not self.total_tokens and (self.input_tokens or self.output_tokens):
            self.total_tokens = self.input_tokens + self.output_tokens
        return self


