#!/usr/bin/env python
"""Count a UTF-8 file's tokens with an OpenAI tokenizer."""

import argparse
from pathlib import Path

import tiktoken


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("file", type=Path)
    parser.add_argument("-m", "--model", help="OpenAI model name (default: o200k_base tokenizer)")
    args = parser.parse_args()
    try:
        encoding = (tiktoken.encoding_for_model(args.model) if args.model is not None
                    else tiktoken.get_encoding("o200k_base"))
    except KeyError:
        parser.error(f"Unknown model: {args.model}")
    try:
        text = args.file.read_bytes().decode("utf-8")
    except (OSError, UnicodeError) as exc:
        parser.error(str(exc))
    print(len(encoding.encode(text, disallowed_special=())))


if __name__ == "__main__":
    main()
