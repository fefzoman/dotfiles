{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Feedback metadata-only hook event v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "collector_version": {
      "const": "0.1.0"
    },
    "source": {
      "const": "hooks"
    },
    "source_schema_version": {
      "const": "documented-hooks-2026-11-14"
    },
    "provider": {
      "enum": [
        "claude",
        "codex"
      ]
    },
    "installation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^([0-9a-f]{32}|[0-9a-f]{64})$"
    },
    "event_type": {
      "enum": [
        "agent.completed",
        "agent.started",
        "collector.gap",
        "context.compacted",
        "permission.requested",
        "session.ended",
        "session.started",
        "tool.completed",
        "tool.failed",
        "tool.started",
        "turn.completed",
        "turn.started"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "occurred_at": {
      "type": "null"
    },
    "context": {
      "type": "object",
      "properties": {
        "coverage": {
          "const": "metadata_only"
        },
        "ordering_uncertain": {
          "const": true
        }
      },
      "required": [
        "coverage",
        "ordering_uncertain"
      ],
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "properties": {
        "raw_payload_retained": {
          "const": false
        },
        "redacted": {
          "const": true
        }
      },
      "required": [
        "raw_payload_retained",
        "redacted"
      ],
      "additionalProperties": false
    },
    "turn_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "span_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "reason": {
      "enum": [
        "invalid_message",
        "oversized_message",
        "unsupported_hook"
      ]
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "Bash",
            "Edit",
            "Glob",
            "Grep",
            "Read",
            "Write",
            "apply_patch",
            "other"
          ]
        },
        "outcome": {
          "enum": [
            "success",
            "failure",
            "unknown"
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "exit_code": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "command_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "path_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "error_family": {
          "enum": [
            "missing_executable"
          ]
        }
      },
      "required": [
        "name",
        "outcome"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "collector_version",
    "source",
    "source_schema_version",
    "provider",
    "installation_id",
    "repository_id",
    "session_id",
    "event_id",
    "event_type",
    "observed_at",
    "occurred_at",
    "context",
    "privacy"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "collector.gap"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    }
  ]
}
