{
  "description": "RTK command rewriting, smart-read hints for large whole-file reads, and Codex context warnings and idle checkpoints, and prompt-cache switch and instruction-edit notes.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/dotfiles/codex_rtk_hook.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/dotfiles/read_hint.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/dotfiles/idle_compact.py\" end --client codex",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/dotfiles/codex_compact_warning.py\"",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/dotfiles/idle_compact.py\" guard --client codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/dotfiles/idle_compact.py\" arm --client codex",
            "async": true,
            "timeout": 11000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/dotfiles/idle_compact.py\" instructions --client codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
