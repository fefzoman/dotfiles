{
  "description": "RTK command rewriting, Serena lifecycle reminders, Context7 version guard, and Codex context warnings and idle checkpoints.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/dotfiles/codex_rtk_hook.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "serena-hooks remind --client=codex"
          }
        ]
      },
      {
        "matcher": "mcp__context7__query-docs",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/dotfiles/context7_version_guard.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks activate --client=codex"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "serena-hooks cleanup --client=codex"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/dotfiles/codex_compact_warning.py\"",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/dotfiles/idle_compact.py\" guard --client codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.config/dotfiles/idle_compact.py\" arm --client codex",
            "async": true,
            "timeout": 11000
          }
        ]
      }
    ]
  }
}
