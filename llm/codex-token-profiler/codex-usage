def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="codex-usage",
        description="Profile local Codex token usage from rollout JSONL files.",
    )
    p.add_argument(
        "--home",
        type=Path,
        default=default_codex_home(),
        help="Codex home (default: $CODEX_HOME or ~/.codex)",
    )
    p.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")

    sub = p.add_subparsers(dest="command")

    current = sub.add_parser("current", help="Analyze the newest local session.")
    current.add_argument("--json", action="store_true", help="Emit JSON.")
    current.add_argument("--top", type=int, default=8, help="Top generators/files/commands.")
    current.add_argument("--calls", type=int, default=10, help="Number of largest model calls.")

    sub.add_parser("short", help="Show a compact report for the newest local session.")

    session = sub.add_parser("session", help="Analyze a session UUID/prefix or rollout path.")
    session.add_argument("selector", help="UUID/prefix or JSONL path.")
    session.add_argument("--json", action="store_true", help="Emit JSON.")
    session.add_argument("--top", type=int, default=8)
    session.add_argument("--calls", type=int, default=10)

    sessions = sub.add_parser("sessions", help="List recent sessions with token totals.")
    sessions.add_argument("--limit", type=int, default=20)
    sessions.add_argument("--archived", action="store_true")

    top = sub.add_parser("top", help="Rank usage across recent sessions.")
    top.add_argument("--by", choices=("session", "command", "file"), default="session")
    top.add_argument("--limit", type=int, default=15)
    top.add_argument("--sessions", type=int, default=50, help="How many recent sessions to scan.")
    top.add_argument("--archived", action="store_true")

    return p


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    home = Path(os.path.expanduser(str(args.home)))

    command = args.command or "current"

    if command == "current":
        path = resolve_session(None, home, include_archived=False)
        r = analyze_session(path)
        if getattr(args, "json", False):
            print(json.dumps(report_to_json(r), indent=2, ensure_ascii=False))
        else:
            render_report(r, top_n=getattr(args, "top", 8), show_calls=getattr(args, "calls", 10))
        return 0

    if command == "short":
        path = resolve_session(None, home, include_archived=False)
        render_short_report(analyze_session(path, keep_calls=False))
        return 0

    if command == "session":
        path = resolve_session(args.selector, home, include_archived=True)
        r = analyze_session(path)
        if args.json:
            print(json.dumps(report_to_json(r), indent=2, ensure_ascii=False))
        else:
            render_report(r, top_n=args.top, show_calls=args.calls)
        return 0

    if command == "sessions":
        render_sessions(home, args.limit, args.archived)
        return 0

    if command == "top":
        render_top(home, args.by, args.limit, args.sessions, args.archived)
        return 0

    parser.print_help()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
