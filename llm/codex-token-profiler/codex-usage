CATEGORY_ORDER = [
    "Repository/file reads",
    "Shell command output",
    "Tests",
    "MCP/tool results",
    "File changes",
    "Conversation/history",
    "AGENTS.md/instructions",
    "Compacted history",
    "Other visible context",
    "Other/platform context",
]


def ordered_items(d: dict[str, float | int]) -> list[tuple[str, float]]:
    order = {name: i for i, name in enumerate(CATEGORY_ORDER)}
    return sorted(
        ((k, float(v)) for k, v in d.items() if v),
        key=lambda kv: (-kv[1], order.get(kv[0], 999), kv[0]),
    )


def render_bar(value: float, max_value: float, width: int = 16) -> str:
    if max_value <= 0:
        return " " * width
    n = max(0, min(width, int(round(width * value / max_value))))
    return "█" * n + "░" * (width - n)


def read_rtk_savings(project: str) -> dict[str, Any] | None:
    rtk = shutil.which("rtk")
    if not rtk:
        return None

    project_path = Path(project).expanduser() if project else None
    project_scoped = bool(project_path and project_path.is_dir())
    command = [rtk, "gain", "--format", "json"]
    if project_scoped:
        command.insert(2, "--project")

    env = os.environ.copy()
    env["RTK_TELEMETRY_DISABLED"] = "1"
    try:
        result = subprocess.run(
            command,
            cwd=str(project_path) if project_scoped else None,
            env=env,
            capture_output=True,
            check=True,
            text=True,
            timeout=5,
        )
        payload = json.loads(result.stdout)
        if not isinstance(payload, dict) or not isinstance(payload.get("summary"), dict):
            return None
        summary = payload["summary"]
        return {
            "scope": "project" if project_scoped else "all",
            "commands": int(summary.get("total_commands") or 0),
            "raw_output_tokens_estimate": int(summary.get("total_input") or 0),
            "filtered_output_tokens_estimate": int(summary.get("total_output") or 0),
            "saved_tokens_estimate": int(summary.get("total_saved") or 0),
            "average_savings_percent": float(summary.get("avg_savings_pct") or 0),
        }
    except (OSError, subprocess.SubprocessError, ValueError, TypeError):
        return None


def render_rtk_savings(report: SessionReport) -> None:
    savings = read_rtk_savings(report.cwd)
    if not savings:
        return

    print()
    print(style("RTK SHELL-OUTPUT SAVINGS — estimated", "bold"))
    print(style("Project aggregate from RTK; separate from exact Codex telemetry.", "dim"))
    print("─" * 72)
    print_kv("Commands", str(savings["commands"]))
    print_kv("Raw output", human_int(savings["raw_output_tokens_estimate"]))
    print_kv("Filtered output", human_int(savings["filtered_output_tokens_estimate"]))
    print_kv(
        "Saved",
        f"{human_int(savings['saved_tokens_estimate'])} "
        f"({savings['average_savings_percent']:.1f}%)",
    )


def render_report(report: SessionReport, top_n: int = 8, show_calls: int = 10) -> None:
    print(style("CODEX TOKEN PROFILE", "bold", "cyan"))
    print("─" * 72)
    print_kv("Session", report.session_id)
    print_kv("Project", report.cwd or "-")
    print_kv("Title", report.title or "-")
    print_kv("Model", " / ".join(filter(None, [report.model or "-", report.reasoning_effort])))
    print_kv("Source", report.source or report.originator or "-")
    print_kv("Codex CLI", report.cli_version or "-")
    print_kv("Rollout", str(report.path))
    print_kv("Rollout size", human_bytes(report.file_size))
    if report.started_at:
        print_kv("Started", report.started_at)
    if report.ended_at:
        print_kv("Last event", report.ended_at)

    print()
    print(style("EXACT USAGE", "bold"))
    print("─" * 72)
    print_kv("Input", human_int(report.total.input_tokens))
    print_kv("Cached input", f"{human_int(report.total.cached_input_tokens)}  ({pct(report.total.cached_input_tokens, report.total.input_tokens)})")
    print_kv("Fresh input", human_int(report.fresh_input))
    print_kv("Output", human_int(report.total.output_tokens))
    print_kv("Reasoning output", human_int(report.total.reasoning_output_tokens))
    print_kv("Total", human_int(report.total.total_tokens or (report.total.input_tokens + report.total.output_tokens)))
    print_kv("Model calls", str(report.model_calls))
    print_kv("Usage telemetry", report.usage_source)
    print_kv("Compactions", str(report.compactions))
    if report.parse_errors:
        print_kv("JSON parse errors", style(str(report.parse_errors), "yellow"))

    if report.context_window:
        print()
        print(style("CURRENT CONTEXT", "bold"))
        print("─" * 72)
        used = report.current_context_tokens
        ratio = report.current_context_ratio
        print_kv("Last call input", f"{human_int(used)} / {human_int(report.context_window)}  ({ratio * 100:.1f}%)")
        print_kv("Last call output", human_int(report.last.output_tokens))
        print_kv("Last reasoning", human_int(report.last.reasoning_output_tokens))

    print()
    print(style("BY ACTIVITY — estimated cumulative input contribution", "bold"))
    print(style("Exact session input is allocated from model-visible context; attribution is approximate.", "dim"))
    print("─" * 72)
    rows = ordered_items(report.cumulative_attribution)
    max_val = max((v for _, v in rows), default=0.0)
    total_attr = sum(v for _, v in rows)
    for name, value in rows:
        print(f"{name:<27} {human_int(value):>9}  {pct(value, total_attr):>6}  {render_bar(value, max_val)}")

    print()
    print(style("OBSERVED PAYLOAD — one-time visible transcript footprint", "bold"))
    print(style("Useful for finding large outputs even when later calls repeatedly re-use them.", "dim"))
    print("─" * 72)
    rows = ordered_items(report.observed_payload)
    max_val = max((v for _, v in rows), default=0.0)
    for name, value in rows:
        print(f"{name:<27} {human_int(value):>9}  {render_bar(value, max_val)}")

    print()
    print(style("TOP TOKEN GENERATORS — estimated model-visible payload", "bold"))
    print("─" * 72)
    generators = sorted(report.generators, key=lambda x: x.payload_tokens, reverse=True)[:top_n]
    if not generators:
        print("(no tool outputs found)")
    else:
        for i, gen in enumerate(generators, 1):
            print(f"{i:>2}. {human_int(gen.payload_tokens):>8}  {gen.kind:<15}  {truncate(gen.label, 88)}")

    if report.file_payloads:
        print()
        print(style("TOP FILES — inferred from read/diff commands", "bold"))
        print("─" * 72)
        for i, (name, tokens) in enumerate(
            sorted(report.file_payloads.items(), key=lambda kv: kv[1], reverse=True)[:top_n], 1
        ):
            print(f"{i:>2}. {human_int(tokens):>8}  {truncate(name, 100)}")

    if report.command_payloads:
        print()
        print(style("TOP COMMANDS — by returned model-visible output", "bold"))
        print("─" * 72)
        for i, (cmd, tokens) in enumerate(
            sorted(report.command_payloads.items(), key=lambda kv: kv[1], reverse=True)[:top_n], 1
        ):
            print(f"{i:>2}. {human_int(tokens):>8}  {truncate(cmd, 105)}")

    if show_calls and report.calls:
        print()
        print(style(f"LARGEST MODEL CALLS — top {min(show_calls, len(report.calls))} by input", "bold"))
        print("─" * 72)
        print(f"{'#':>3}  {'timestamp':<24} {'input':>9} {'cached':>9} {'fresh':>9} {'output':>8} {'ctx':>7}")
        ranked = sorted(enumerate(report.calls, 1), key=lambda x: x[1].usage.input_tokens, reverse=True)[:show_calls]
        for idx, call in ranked:
            fresh = max(0, call.usage.input_tokens - call.usage.cached_input_tokens)
            ts = call.timestamp.replace("T", " ")[:23]
            print(
                f"{idx:>3}  {ts:<24} {human_int(call.usage.input_tokens):>9} "
                f"{human_int(call.usage.cached_input_tokens):>9} {human_int(fresh):>9} "
                f"{human_int(call.usage.output_tokens):>8} {call.context_ratio * 100:>6.1f}%"
            )

    render_rtk_savings(report)

    print()
    print(style("NOTES", "bold"))
    print("─" * 72)
    print("• Exact usage comes from Codex cumulative token counters.")
    print("• Cached input is a subset of input; it is not added on top of input.")
    print("• Reasoning output is reported separately but is already part of output accounting semantics.")
    print("• Activity/file/command figures are estimates and should be used for optimization, not billing.")


