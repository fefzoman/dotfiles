def render_sessions(home: Path, limit: int, include_archived: bool) -> None:
    paths = discover_rollouts(home, include_archived=include_archived)[:limit]
    if not paths:
        raise SystemExit(f"No rollout files found under {home}")

    print(style(f"RECENT CODEX SESSIONS — {home}", "bold", "cyan"))
    print("─" * 118)
    print(f"{'session':<14} {'project':<28} {'input':>9} {'cached':>9} {'output':>8} {'calls':>6} {'ctx':>7}  title")
    for path in paths:
        r = analyze_session(path, keep_calls=False)
        short_id = r.session_id[:12]
        project = Path(r.cwd).name if r.cwd else "-"
        ctx = f"{r.current_context_ratio * 100:.0f}%" if r.context_window else "-"
        print(
            f"{short_id:<14} {truncate(project, 27):<28} "
            f"{human_int(r.total.input_tokens):>9} {human_int(r.total.cached_input_tokens):>9} "
            f"{human_int(r.total.output_tokens):>8} {r.model_calls:>6} {ctx:>7}  "
            f"{truncate(r.title, 46)}"
        )


def render_top(home: Path, by: str, limit: int, sessions: int, include_archived: bool) -> None:
    paths = discover_rollouts(home, include_archived=include_archived)[:sessions]
    if not paths:
        raise SystemExit(f"No rollout files found under {home}")

    if by == "session":
        rows = []
        for path in paths:
            r = analyze_session(path, keep_calls=False)
            rows.append((r.total.input_tokens, r))
        rows.sort(key=lambda x: x[0], reverse=True)
        print(style(f"TOP SESSIONS BY INPUT TOKENS — scanned {len(paths)}", "bold", "cyan"))
        print("─" * 110)
        for i, (_, r) in enumerate(rows[:limit], 1):
            print(
                f"{i:>2}. {human_int(r.total.input_tokens):>9}  "
                f"{r.session_id[:12]:<12}  {truncate(Path(r.cwd).name if r.cwd else '-', 24):<24}  "
                f"{truncate(r.title, 58)}"
            )
        return

    aggregate: dict[str, int] = collections.defaultdict(int)
    for path in paths:
        r = analyze_session(path, keep_calls=False)
        source = r.command_payloads if by == "command" else r.file_payloads
        for key, value in source.items():
            aggregate[key] += value

    print(style(f"TOP {by.upper()}S — estimated payload across {len(paths)} sessions", "bold", "cyan"))
    print("─" * 110)
    for i, (name, tokens) in enumerate(
        sorted(aggregate.items(), key=lambda kv: kv[1], reverse=True)[:limit], 1
    ):
        print(f"{i:>2}. {human_int(tokens):>9}  {truncate(name, 100)}")


